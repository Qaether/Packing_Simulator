{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExperimentConfig",
  "type": "object",
  "properties": {
    "ell_q": { "type": "number", "default": 1.0 },
    "radius": { "type": "number", "default": 0.5 },
    "k_core": { "type": "number", "default": 1.0 },
    "damping": { "type": "number", "default": 1.0 },
    "dt": { "type": "number", "default": 0.01 },
    "relax_dt": { "type": ["number", "null"], "default": null },
    "relax_steps": { "type": "integer", "default": 80 },
    "relax_min_steps": { "type": "integer", "default": 20 },
    "relax_convergence_window": { "type": "integer", "default": 10 },
    "relax_msd_tolerance": { "type": "number", "default": 1e-14 },
    "relax_force_tolerance": { "type": "number", "default": 1e-6 },
    "dynamics_steps": { "type": "integer", "default": 120 },
    "snapshot_stride": { "type": "integer", "default": 10 },
    "epsilon_contact": { "type": "number", "default": 0.06 },
    "epsilon_contact_on": { "type": "number", "default": 0.01 },
    "epsilon_contact_off": { "type": "number", "default": 0.02 },
    "epsilon_cycle": { "type": "number", "default": 0.10 },
    "epsilon_planar": { "type": "number", "default": 0.12 },
    "epsilon_volume": { "type": "number", "default": 1e-4 },
    "epsilon_center": { "type": "number", "default": 0.15 },
    "epsilon_perp": { "type": "number", "default": 0.25 },
    "phi_targets": {
      "type": "array",
      "items": { "type": "number" }
    },
    "omega_q": { "type": "number", "default": 1.0 },
    "lambda_phase": { "type": "number", "default": 0.0 }
  },
  "required": ["ell_q", "radius", "k_core", "damping", "dt", "relax_dt", "relax_steps", "relax_min_steps", "relax_convergence_window", "relax_msd_tolerance", "relax_force_tolerance", "dynamics_steps", "snapshot_stride", "epsilon_contact", "epsilon_cycle", "epsilon_planar", "epsilon_volume", "epsilon_center", "epsilon_perp", "phi_targets", "omega_q", "lambda_phase"]
}
